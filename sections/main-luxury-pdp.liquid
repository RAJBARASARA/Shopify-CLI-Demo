{%- comment -%}
  Luxury PDP — custom product detail section for Zenn Space.
  All core content is dynamic (title, description, price, variants, images, inventory).
  Marketing copy (feature cards, badges, rating) reads product metafields with
  section-setting fallbacks. Built to be self-contained; safe on Horizon.
{%- endcomment -%}

{%- assign p = product -%}
{%- assign cur = p.selected_or_first_available_variant -%}

{%- comment -%} Detect a colour option and the primary (size) option {%- endcomment -%}
{%- assign color_pos = 0 -%}
{%- assign size_pos = 0 -%}
{%- for opt in p.options_with_values -%}
  {%- assign oname = opt.name | downcase -%}
  {%- if oname contains 'color' or oname contains 'colour' -%}
    {%- assign color_pos = opt.position -%}
  {%- elsif size_pos == 0 -%}
    {%- assign size_pos = opt.position -%}
  {%- endif -%}
{%- endfor -%}
{%- assign color_idx = color_pos | minus: 1 -%}
{%- assign size_idx = size_pos | minus: 1 -%}

{%- comment -%} Metafields (custom namespace) with fallbacks {%- endcomment -%}
{%- assign mf_rating = p.metafields.custom.rating | default: section.settings.default_rating -%}
{%- assign mf_reviews = p.metafields.custom.review_count | default: section.settings.default_reviews -%}
{%- assign mf_fabric = p.metafields.custom.fabric | default: section.settings.default_fabric -%}
{%- assign mf_fit = p.metafields.custom.fit | default: section.settings.default_fit -%}
{%- assign mf_feeling = p.metafields.custom.feeling | default: section.settings.default_feeling -%}
{%- assign rating_round = mf_rating | round -%}

<section class="lux-pdp" id="lux-pdp-{{ section.id }}">
  <div class="lux-wrap">

    {%- comment -%} ==================== LEFT: GALLERY ==================== {%- endcomment -%}
    <div class="lux-left">
      <div class="lux-gallery">
        <div class="lux-thumbs" role="listbox" aria-label="Product images">
          {%- for media in p.media -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" class="lux-thumb{% if forloop.first %} is-active{% endif %}"
                      data-full="{{ media | image_url: width: 1200 }}"
                      data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape | default: p.title }}" loading="lazy" width="80" height="100">
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="lux-main-img">
          {%- if p.featured_media -%}
            <img id="lux-hero-{{ section.id }}" src="{{ p.featured_media | image_url: width: 1200 }}"
                 alt="{{ p.featured_media.alt | escape | default: p.title }}" width="600" height="750">
          {%- else -%}
            <div class="lux-noimg">{{ 'products.product.no_image' | t | default: 'No image' }}</div>
          {%- endif -%}
          <div class="lux-overlay">
            <div class="lux-overlay-card">
              <span class="lux-oc-title">{{ section.settings.overlay1_title }}</span>
              <p>{{ section.settings.overlay1_text }}</p>
            </div>
            <div class="lux-overlay-card">
              <span class="lux-oc-title">{{ section.settings.overlay2_title }}</span>
              <p>{{ section.settings.overlay2_text }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} ==================== RIGHT: DETAILS ==================== {%- endcomment -%}
    <div class="lux-right">

      <div class="lux-eyebrow">{{ section.settings.label_text }}</div>

      {%- comment -%} rating + reviews + best seller {%- endcomment -%}
      <div class="lux-social">
        <span class="lux-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <span class="lux-star{% if i <= rating_round %} is-full{% endif %}">&#9733;</span>
          {%- endfor -%}
        </span>
        <span class="lux-rating-num">{{ mf_rating }}</span>
        <span class="lux-reviews">{{ mf_reviews }} reviews</span>
        {%- if section.settings.show_best_seller -%}
          <span class="lux-dot-sep">&bull;</span>
          <span class="lux-bestseller">{{ section.settings.best_seller_text }}</span>
        {%- endif -%}
      </div>

      <h1 class="lux-title">{{ p.title }}</h1>

      {%- if p.description != blank -%}
        <div class="lux-desc">{{ p.description }}</div>
      {%- endif -%}

      {%- comment -%} price {%- endcomment -%}
      <div class="lux-price-row">
        <span class="lux-price" id="lux-price-{{ section.id }}">{{ cur.price | money }}</span>
        <span class="lux-compare" id="lux-compare-{{ section.id }}"
              {% unless cur.compare_at_price > cur.price %}style="display:none"{% endunless %}>
          {{ cur.compare_at_price | money }}
        </span>
        <span class="lux-drop-badge">{{ section.settings.drop_badge_text }}</span>
      </div>

      {%- comment -%} feature cards {%- endcomment -%}
      <div class="lux-features">
        <div class="lux-feature"><span class="lux-f-title">FABRIC</span><p>{{ mf_fabric }}</p></div>
        <div class="lux-feature"><span class="lux-f-title">FIT</span><p>{{ mf_fit }}</p></div>
        <div class="lux-feature"><span class="lux-f-title">FEELING</span><p>{{ mf_feeling }}</p></div>
      </div>

      {%- form 'product', p, id: 'lux-form', class: 'lux-form' -%}
        <input type="hidden" name="id" id="lux-varid-{{ section.id }}" value="{{ cur.id }}">

        {%- comment -%} COLOUR (only if a colour option exists) {%- endcomment -%}
        {%- if color_pos > 0 -%}
          {%- assign copt = p.options_with_values[color_idx] -%}
          <div class="lux-opt-block">
            <div class="lux-opt-head">
              <span class="lux-opt-label">COLOR / <b id="lux-colorname-{{ section.id }}">{{ cur.options[color_idx] | upcase }}</b></span>
              <a href="{{ section.settings.help_link }}" class="lux-mini-link">NEED HELP CHOOSING</a>
            </div>
            <div class="lux-swatches" data-option-position="{{ color_pos }}">
              {%- for val in copt.values -%}
                <button type="button" class="lux-swatch{% if val == cur.options[color_idx] %} is-active{% endif %}"
                        data-value="{{ val | escape }}" title="{{ val | escape }}"
                        style="--sw: {{ val | handle }};" aria-label="{{ val | escape }}">
                  <span class="lux-swatch-inner" data-name="{{ val | downcase | escape }}"></span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} SIZE / primary option {%- endcomment -%}
        {%- if size_pos > 0 -%}
          {%- assign sopt = p.options_with_values[size_idx] -%}
          <div class="lux-opt-block">
            <div class="lux-opt-head">
              <span class="lux-opt-label">{{ sopt.name | upcase }}</span>
              <a href="{{ section.settings.size_guide_link }}" class="lux-mini-link">SIZE GUIDE</a>
            </div>
            <div class="lux-sizes" data-option-position="{{ size_pos }}">
              {%- for val in sopt.values -%}
                <button type="button" class="lux-size{% if val == cur.options[size_idx] %} is-active{% endif %}"
                        data-value="{{ val | escape }}">{{ val }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} stock {%- endcomment -%}
        <div class="lux-stock" id="lux-stock-{{ section.id }}" data-available="{{ cur.available }}">
          <span class="lux-stock-dot"></span>
          <span class="lux-stock-text">{% if cur.available %}{{ section.settings.instock_text }}{% else %}{{ section.settings.oos_text }}{% endif %}</span>
        </div>

        {%- comment -%} quantity + add to bag {%- endcomment -%}
        <div class="lux-buy-row">
          <div class="lux-qty">
            <button type="button" class="lux-qty-btn" data-dir="-1" aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" id="lux-qty-{{ section.id }}" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" class="lux-qty-btn" data-dir="1" aria-label="Increase quantity">&plus;</button>
          </div>
          <button type="submit" name="add" class="lux-btn lux-btn-primary" id="lux-addbtn-{{ section.id }}"
                  {% unless cur.available %}disabled{% endunless %}>
            <span>{% if cur.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</span>
          </button>
        </div>

        <button type="button" class="lux-btn lux-btn-outline" id="lux-buynow-{{ section.id }}"
                {% unless cur.available %}disabled{% endunless %}>BUY NOW</button>

        <div class="lux-secondary-row">
          <button type="button" class="lux-btn lux-btn-ghost" data-lux-save aria-pressed="false">SAVE</button>
          <a href="{{ section.settings.gift_link }}" class="lux-btn lux-btn-ghost">GIFT THIS</a>
        </div>
      {%- endform -%}

      <p class="lux-cro">{{ section.settings.cro_text }}</p>

      {%- comment -%} info badges {%- endcomment -%}
      <div class="lux-info-badges">
        <div class="lux-info"><span class="lux-info-title">{{ section.settings.badge1_title }}</span><p>{{ section.settings.badge1_text }}</p></div>
        <div class="lux-info"><span class="lux-info-title">{{ section.settings.badge2_title }}</span><p>{{ section.settings.badge2_text }}</p></div>
        <div class="lux-info"><span class="lux-info-title">{{ section.settings.badge3_title }}</span><p>{{ section.settings.badge3_text }}</p></div>
      </div>

    </div>
  </div>

  {%- comment -%} variant data for JS {%- endcomment -%}
  <script type="application/json" id="lux-data-{{ section.id }}">
    {
      "variants": [
        {%- for v in p.variants -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available }},
          "price": {{ v.price | money | json }},
          "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

<style>
  #lux-pdp-{{ section.id }}{
    --cream:#F5F0EB; --card:#FBF8F4; --card2:#EFE7DC; --ink:#1A1512; --muted:#8A7F73;
    --line:#E3D9CC; --accent:#1A1512; --serif:'Playfair Display',Georgia,'Times New Roman',serif;
    --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    background:var(--cream); color:var(--ink); font-family:var(--sans);
    padding:clamp(20px,4vw,56px); box-sizing:border-box;
  }
  #lux-pdp-{{ section.id }} *{box-sizing:border-box;}
  #lux-pdp-{{ section.id }} .lux-wrap{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,3vw,56px);align-items:start;}
  /* gallery */
  #lux-pdp-{{ section.id }} .lux-gallery{display:grid;grid-template-columns:88px 1fr;gap:16px;}
  #lux-pdp-{{ section.id }} .lux-thumbs{display:flex;flex-direction:column;gap:12px;}
  #lux-pdp-{{ section.id }} .lux-thumb{padding:0;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--card);cursor:pointer;aspect-ratio:4/5;transition:.2s;}
  #lux-pdp-{{ section.id }} .lux-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  #lux-pdp-{{ section.id }} .lux-thumb.is-active{border-color:var(--ink);box-shadow:0 0 0 1px var(--ink);}
  #lux-pdp-{{ section.id }} .lux-main-img{position:relative;border-radius:24px;overflow:hidden;background:var(--card);aspect-ratio:4/5;}
  #lux-pdp-{{ section.id }} .lux-main-img img{width:100%;height:100%;object-fit:cover;display:block;}
  #lux-pdp-{{ section.id }} .lux-noimg{display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);}
  #lux-pdp-{{ section.id }} .lux-overlay{position:absolute;left:16px;right:16px;bottom:16px;display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  #lux-pdp-{{ section.id }} .lux-overlay-card{background:rgba(251,248,244,.86);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:14px;padding:12px 14px;}
  #lux-pdp-{{ section.id }} .lux-oc-title{font-size:10px;letter-spacing:.14em;font-weight:700;color:var(--ink);display:block;margin-bottom:4px;}
  #lux-pdp-{{ section.id }} .lux-overlay-card p{margin:0;font-size:11px;line-height:1.4;color:var(--muted);}
  /* right */
  #lux-pdp-{{ section.id }} .lux-eyebrow{font-size:10px;letter-spacing:.22em;color:var(--muted);font-weight:600;padding-top:6px;border-top:1px solid var(--line);display:inline-block;}
  #lux-pdp-{{ section.id }} .lux-social{display:flex;align-items:center;gap:8px;margin:18px 0 14px;flex-wrap:wrap;font-size:12px;color:var(--muted);}
  #lux-pdp-{{ section.id }} .lux-stars{letter-spacing:1px;}
  #lux-pdp-{{ section.id }} .lux-star{color:var(--line);}
  #lux-pdp-{{ section.id }} .lux-star.is-full{color:#C9A24B;}
  #lux-pdp-{{ section.id }} .lux-rating-num{font-weight:700;color:var(--ink);}
  #lux-pdp-{{ section.id }} .lux-bestseller{font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.08em;font-size:11px;}
  #lux-pdp-{{ section.id }} .lux-title{font-family:var(--serif);font-weight:700;text-transform:uppercase;line-height:1.02;letter-spacing:.01em;font-size:clamp(30px,4vw,52px);margin:6px 0 16px;color:var(--ink);}
  #lux-pdp-{{ section.id }} .lux-desc{color:var(--muted);line-height:1.6;font-size:14px;max-width:52ch;}
  #lux-pdp-{{ section.id }} .lux-desc p{margin:0 0 8px;}
  #lux-pdp-{{ section.id }} .lux-price-row{display:flex;align-items:center;gap:12px;margin:22px 0;}
  #lux-pdp-{{ section.id }} .lux-price{font-size:30px;font-weight:800;color:var(--ink);}
  #lux-pdp-{{ section.id }} .lux-compare{font-size:16px;color:var(--muted);text-decoration:line-through;}
  #lux-pdp-{{ section.id }} .lux-drop-badge{font-size:10px;letter-spacing:.12em;font-weight:700;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:5px 10px;}
  #lux-pdp-{{ section.id }} .lux-features{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:6px 0 24px;}
  #lux-pdp-{{ section.id }} .lux-feature{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;}
  #lux-pdp-{{ section.id }} .lux-f-title{font-size:10px;letter-spacing:.14em;font-weight:700;display:block;margin-bottom:6px;}
  #lux-pdp-{{ section.id }} .lux-feature p{margin:0;font-size:11.5px;line-height:1.45;color:var(--muted);}
  #lux-pdp-{{ section.id }} .lux-opt-block{margin:18px 0;}
  #lux-pdp-{{ section.id }} .lux-opt-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
  #lux-pdp-{{ section.id }} .lux-opt-label{font-size:11px;letter-spacing:.14em;font-weight:700;}
  #lux-pdp-{{ section.id }} .lux-mini-link{font-size:10px;letter-spacing:.1em;color:var(--muted);text-decoration:none;border-bottom:1px solid var(--line);}
  #lux-pdp-{{ section.id }} .lux-swatches{display:flex;gap:10px;}
  #lux-pdp-{{ section.id }} .lux-swatch{width:34px;height:34px;border-radius:50%;padding:3px;border:1px solid var(--line);background:none;cursor:pointer;}
  #lux-pdp-{{ section.id }} .lux-swatch.is-active{border-color:var(--ink);box-shadow:0 0 0 1px var(--ink);}
  #lux-pdp-{{ section.id }} .lux-swatch-inner{display:block;width:100%;height:100%;border-radius:50%;background:#cbb89f;}
  #lux-pdp-{{ section.id }} .lux-sizes{display:flex;gap:10px;flex-wrap:wrap;}
  #lux-pdp-{{ section.id }} .lux-size{min-width:52px;padding:11px 14px;border:1px solid var(--line);border-radius:12px;background:var(--card);cursor:pointer;font-size:12px;font-weight:600;color:var(--ink);transition:.15s;}
  #lux-pdp-{{ section.id }} .lux-size.is-active{background:var(--ink);color:#fff;border-color:var(--ink);}
  #lux-pdp-{{ section.id }} .lux-size:disabled{opacity:.35;cursor:not-allowed;text-decoration:line-through;}
  #lux-pdp-{{ section.id }} .lux-stock{display:flex;align-items:center;gap:8px;margin:20px 0 14px;font-size:11px;letter-spacing:.12em;font-weight:700;text-transform:uppercase;}
  #lux-pdp-{{ section.id }} .lux-stock-dot{width:8px;height:8px;border-radius:50%;background:#3FA66A;}
  #lux-pdp-{{ section.id }} .lux-stock[data-available="false"] .lux-stock-dot{background:#C0472F;}
  #lux-pdp-{{ section.id }} .lux-buy-row{display:flex;gap:12px;align-items:stretch;margin-bottom:12px;}
  #lux-pdp-{{ section.id }} .lux-qty{display:flex;align-items:center;border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden;}
  #lux-pdp-{{ section.id }} .lux-qty-btn{width:42px;height:100%;border:none;background:none;font-size:18px;cursor:pointer;color:var(--ink);}
  #lux-pdp-{{ section.id }} .lux-qty input{width:44px;text-align:center;border:none;background:none;font-size:15px;color:var(--ink);-moz-appearance:textfield;}
  #lux-pdp-{{ section.id }} .lux-qty input::-webkit-outer-spin-button,#lux-pdp-{{ section.id }} .lux-qty input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  #lux-pdp-{{ section.id }} .lux-btn{width:100%;border-radius:14px;padding:16px;font-size:12px;letter-spacing:.14em;font-weight:700;cursor:pointer;transition:.18s;text-align:center;text-decoration:none;display:inline-block;}
  #lux-pdp-{{ section.id }} .lux-btn-primary{flex:1;background:var(--ink);color:#fff;border:1px solid var(--ink);}
  #lux-pdp-{{ section.id }} .lux-btn-primary:hover{opacity:.9;}
  #lux-pdp-{{ section.id }} .lux-btn-outline{background:transparent;color:var(--ink);border:1px solid var(--ink);margin-bottom:12px;}
  #lux-pdp-{{ section.id }} .lux-btn-outline:hover{background:var(--ink);color:#fff;}
  #lux-pdp-{{ section.id }} .lux-btn:disabled{opacity:.4;cursor:not-allowed;}
  #lux-pdp-{{ section.id }} .lux-secondary-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  #lux-pdp-{{ section.id }} .lux-btn-ghost{background:var(--card);color:var(--ink);border:1px solid var(--line);}
  #lux-pdp-{{ section.id }} .lux-btn-ghost[aria-pressed="true"]{background:var(--ink);color:#fff;border-color:var(--ink);}
  #lux-pdp-{{ section.id }} .lux-cro{font-size:11px;line-height:1.5;color:var(--muted);margin:16px 0 22px;font-style:italic;}
  #lux-pdp-{{ section.id }} .lux-info-badges{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding-top:20px;border-top:1px solid var(--line);}
  #lux-pdp-{{ section.id }} .lux-info-title{font-size:10px;letter-spacing:.12em;font-weight:700;display:block;margin-bottom:6px;}
  #lux-pdp-{{ section.id }} .lux-info p{margin:0;font-size:11px;line-height:1.45;color:var(--muted);}
  @media (max-width:900px){
    #lux-pdp-{{ section.id }} .lux-wrap{grid-template-columns:1fr;}
    #lux-pdp-{{ section.id }} .lux-features,#lux-pdp-{{ section.id }} .lux-info-badges{grid-template-columns:1fr;}
    #lux-pdp-{{ section.id }} .lux-overlay{grid-template-columns:1fr;}
  }
</style>

<script>
(function(){
  var root = document.getElementById('lux-pdp-{{ section.id }}');
  if(!root) return;
  var sid = '{{ section.id }}';
  var dataEl = document.getElementById('lux-data-'+sid);
  var VARIANTS = [];
  try { VARIANTS = JSON.parse(dataEl.textContent).variants; } catch(e){}

  var colorNames = {
    'sandstone ash':'#C9B79C','sand':'#D8C4A5','ash':'#B8AEA1','black':'#1a1a1a','white':'#f3f0ea',
    'cream':'#efe7d8','beige':'#e2d3bb','stone':'#cbbfa8','brown':'#7a5c40','olive':'#7a7a4d',
    'charcoal':'#3a3a3a','grey':'#9a958d','gray':'#9a958d','navy':'#2a3448','red':'#a83232',
    'green':'#4d6b4d','blue':'#3f5b7a','pink':'#d9a7ad','tan':'#c9a271'
  };
  // paint swatch inners from name
  root.querySelectorAll('.lux-swatch-inner').forEach(function(el){
    var n=(el.getAttribute('data-name')||'').trim();
    if(colorNames[n]) el.style.background=colorNames[n];
  });

  var qtyInput = document.getElementById('lux-qty-'+sid);
  var varidInput = document.getElementById('lux-varid-'+sid);
  var priceEl = document.getElementById('lux-price-'+sid);
  var compareEl = document.getElementById('lux-compare-'+sid);
  var stockEl = document.getElementById('lux-stock-'+sid);
  var addBtn = document.getElementById('lux-addbtn-'+sid);
  var buyBtn = document.getElementById('lux-buynow-'+sid);
  var heroImg = document.getElementById('lux-hero-'+sid);
  var colorNameEl = document.getElementById('lux-colorname-'+sid);

  // ---- gallery thumbnails ----
  root.querySelectorAll('.lux-thumb').forEach(function(t){
    t.addEventListener('click', function(){
      var full=t.getAttribute('data-full');
      if(heroImg && full){ heroImg.src=full; }
      root.querySelectorAll('.lux-thumb').forEach(function(x){x.classList.remove('is-active');});
      t.classList.add('is-active');
    });
  });

  // ---- option selection ----
  function selectedOptions(){
    var opts=[];
    root.querySelectorAll('[data-option-position]').forEach(function(group){
      var pos=parseInt(group.getAttribute('data-option-position'),10)-1;
      var active=group.querySelector('.is-active');
      if(active) opts[pos]=active.getAttribute('data-value');
    });
    return opts;
  }
  function findVariant(opts){
    return VARIANTS.find(function(v){
      return v.options.every(function(val,i){ return opts[i]===undefined || opts[i]===val; });
    });
  }
  function updateVariant(){
    var opts=selectedOptions();
    var v=findVariant(opts);
    if(!v) return;
    varidInput.value=v.id;
    if(priceEl) priceEl.textContent=v.price;
    if(compareEl){ if(v.compare){ compareEl.textContent=v.compare; compareEl.style.display=''; } else { compareEl.style.display='none'; } }
    if(stockEl){
      stockEl.setAttribute('data-available', v.available?'true':'false');
      var txt=stockEl.querySelector('.lux-stock-text');
      if(txt) txt.textContent=v.available ? {{ section.settings.instock_text | json }} : {{ section.settings.oos_text | json }};
    }
    if(addBtn){ addBtn.disabled=!v.available; addBtn.querySelector('span').textContent=v.available?'ADD TO BAG':'SOLD OUT'; }
    if(buyBtn){ buyBtn.disabled=!v.available; }
  }

  root.querySelectorAll('.lux-sizes .lux-size, .lux-swatches .lux-swatch').forEach(function(btn){
    btn.addEventListener('click', function(){
      var group=btn.closest('[data-option-position]');
      group.querySelectorAll('.is-active').forEach(function(x){x.classList.remove('is-active');});
      btn.classList.add('is-active');
      if(group.classList.contains('lux-swatches') && colorNameEl){
        colorNameEl.textContent=(btn.getAttribute('data-value')||'').toUpperCase();
      }
      updateVariant();
    });
  });

  // ---- quantity ----
  root.querySelectorAll('.lux-qty-btn').forEach(function(b){
    b.addEventListener('click', function(){
      var cur=parseInt(qtyInput.value,10)||1;
      cur+=parseInt(b.getAttribute('data-dir'),10);
      if(cur<1) cur=1;
      qtyInput.value=cur;
    });
  });

  // ---- buy now: add then go to checkout ----
  if(buyBtn){
    buyBtn.addEventListener('click', function(){
      if(buyBtn.disabled) return;
      buyBtn.textContent='…';
      fetch('{{ routes.cart_add_url }}', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ id: varidInput.value, quantity: parseInt(qtyInput.value,10)||1 })
      }).then(function(){ window.location.href='{{ routes.cart_url }}/checkout'; })
        .catch(function(){ buyBtn.textContent='BUY NOW'; });
    });
  }

  // ---- save toggle (local visual) ----
  var saveBtn=root.querySelector('[data-lux-save]');
  if(saveBtn){
    saveBtn.addEventListener('click', function(){
      var on=saveBtn.getAttribute('aria-pressed')==='true';
      saveBtn.setAttribute('aria-pressed', on?'false':'true');
      saveBtn.textContent= on ? 'SAVE' : 'SAVED';
    });
  }

  updateVariant();
})();
</script>

