{% comment %}
  Zenn-space trust bar.
  A row of "why shop with us" features (icon + title + text) as blocks.
  Brand tokens + Fraunces from snippets/zenn-brand.liquid.
{% endcomment %}

{% render 'zenn-brand' %}
{{ 'custom-trust-bar.css' | asset_url | stylesheet_tag }}

{% liquid
  assign s = section.settings
  assign bg = s.background | default: 'sand'
%}

<section class="ztrust ztrust--{{ bg }}">
  <div class="ztrust__wrap">
    {%- if s.heading != blank -%}
      <h2 class="ztrust__heading">{{ s.heading | escape }}</h2>
    {%- endif -%}

    <ul class="ztrust__grid" role="list" style="--ztrust-cols: {{ section.blocks.size | at_least: 1 }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="ztrust__item" {{ block.shopify_attributes }}>
          <span class="ztrust__icon" aria-hidden="true">
            {%- case b.icon -%}
              {%- when 'shipping' -%}
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/><circle cx="17.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- when 'returns' -%}
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="M4 9a8 8 0 1 1-1 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M3 4v5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'quality' -%}
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'sustainable' -%}
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="M20 4s-1 9-6 12c-4 2.4-8 1-8 1s-1-9 6-12c3-1.3 8-1 8-1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M6 18c3-4 6-6 10-8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              {%- when 'support' -%}
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="M5 12a7 7 0 0 1 14 0v4a2 2 0 0 1-2 2h-1v-6h3M5 12v4M5 12H4m1 4v0a2 2 0 0 0 2 2h1v-6H5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {%- when 'gift' -%}
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="M4 9h16v3H4zM5 12h14v8H5zM12 9v11" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 9S9 3 6.5 5.5 12 9 12 9zm0 0s3-6 5.5-3.5S12 9 12 9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none"><path d="M12 3l2.4 5.6L20 9.2l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </span>
          {%- if b.title != blank -%}<h3 class="ztrust__title">{{ b.title | escape }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<p class="ztrust__text">{{ b.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "ztrust-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Zenn-space"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "sand", "label": "Sand" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "charcoal", "label": "Charcoal" },
        { "value": "white", "label": "White" }
      ],
      "default": "sand"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "quality", "label": "Quality / guarantee" },
            { "value": "sustainable", "label": "Sustainable" },
            { "value": "support", "label": "Support" },
            { "value": "gift", "label": "Gift" },
            { "value": "star", "label": "Star" }
          ],
          "default": "star"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "text", "id": "text", "label": "Text", "default": "Short supporting sentence." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "quality", "title": "Considered materials", "text": "Premium fabrics chosen to last, not to landfill." } },
        { "type": "feature", "settings": { "icon": "shipping", "title": "Fast, free shipping", "text": "Complimentary delivery on orders over the threshold." } },
        { "type": "feature", "settings": { "icon": "returns", "title": "Easy 30-day returns", "text": "Changed your mind? Send it back, on us." } },
        { "type": "feature", "settings": { "icon": "support", "title": "Here to help", "text": "A real team, ready whenever you need us." } }
      ]
    }
  ]
}
{% endschema %}
