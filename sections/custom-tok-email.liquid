{% comment %} Threads of Kaos — Join The Movement (email capture). Self-contained. {% endcomment %}
{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}
<section class="tks-eml" id="tks-eml-{{ uid }}" style="
  --c-page:{{ s.page_bg }};--c-frame-a:{{ s.frame_start }};--c-frame-b:{{ s.frame_end }};--c-panel-a:{{ s.panel_start }};--c-panel-b:{{ s.panel_end }};
  --c-head:{{ s.heading_color }};--c-muted:{{ s.muted_color }};--c-eye:{{ s.eyebrow_color }};--c-input:{{ s.input_bg }};
  --c-btn:{{ s.button_bg }};--c-btntxt:{{ s.button_text }};--r:{{ s.corner_radius }}px;--pad:{{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="tks-eml__frame">
    <div class="tks-eml__inner">
      <div class="tks-eml__left">
        {% if s.eyebrow != blank %}<p class="tks-eml__eye">{{ s.eyebrow }}</p>{% endif %}
        {% if s.heading != blank %}<h2 class="tks-eml__title">{{ s.heading }}</h2>{% endif %}
        {% if s.body != blank %}<p class="tks-eml__body">{{ s.body }}</p>{% endif %}
        {% if s.perks != blank %}<p class="tks-eml__perks">{{ s.perks }}</p>{% endif %}
        {% form 'customer', class: 'tks-eml__form' %}
          {% if form.posted_successfully? %}<p class="tks-eml__ok">{{ s.success_text }}</p>{% endif %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" class="tks-eml__input" placeholder="{{ s.placeholder | default: 'Enter your email address' }}" required aria-label="Email address">
          <button type="submit" class="tks-eml__btn">{{ s.button_label | default: 'Join now' }}</button>
        {% endform %}
      </div>
      <div class="tks-eml__visual">
        {% if s.image != blank %}{{ s.image | image_url: width: 1200 | image_tag: loading:'lazy', class:'tks-eml__img', widths:'400,800,1200', alt: s.heading }}
        {% else %}
          <span class="tks-eml__rect tks-eml__rect--a" aria-hidden="true"></span>
          <span class="tks-eml__rect tks-eml__rect--b" aria-hidden="true"></span>
        {% endif %}
      </div>
    </div>
  </div>
</section>
<style>
  #tks-eml-{{ uid }}.tks-eml{padding:var(--pad);background:var(--c-page);}
  #tks-eml-{{ uid }} .tks-eml__frame{max-width:1240px;margin:0 auto;padding:clamp(28px,3vw,52px);border-radius:calc(var(--r)*1.3);background:radial-gradient(120% 120% at 20% 0%,var(--c-frame-a),var(--c-frame-b));box-shadow:0 34px 70px -44px rgba(60,45,30,.45);}
  #tks-eml-{{ uid }} .tks-eml__inner{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,4vw,56px);align-items:center;}
  #tks-eml-{{ uid }} .tks-eml__eye{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--c-eye);font-weight:600;margin:0 0 16px;}
  #tks-eml-{{ uid }} .tks-eml__title{font-family:{{ s.heading_font.family }},{{ s.heading_font.fallback_families }};font-weight:{{ s.heading_font.weight }};font-size:clamp(34px,4vw,56px);line-height:1;letter-spacing:-.01em;color:var(--c-head);margin:0 0 20px;}
  #tks-eml-{{ uid }} .tks-eml__body{font-size:15px;line-height:1.65;color:var(--c-muted);margin:0 0 22px;max-width:40ch;}
  #tks-eml-{{ uid }} .tks-eml__perks{display:inline-block;background:rgba(255,255,255,.7);border:1px solid rgba(255,255,255,.8);font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;color:var(--c-head);padding:10px 18px;border-radius:999px;margin:0 0 22px;}
  #tks-eml-{{ uid }} .tks-eml__form{display:flex;align-items:center;gap:8px;background:var(--c-input);border-radius:999px;padding:8px 8px 8px 22px;max-width:460px;box-shadow:0 18px 40px -24px rgba(60,45,30,.4);}
  #tks-eml-{{ uid }} .tks-eml__input{flex:1;border:0;background:transparent;font-size:14px;color:var(--c-head);outline:none;padding:12px 0;}
  #tks-eml-{{ uid }} .tks-eml__btn{flex:0 0 auto;background:var(--c-btn);color:var(--c-btntxt);border:0;cursor:pointer;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;padding:14px 26px;border-radius:999px;transition:transform .15s ease,opacity .15s ease;}
  #tks-eml-{{ uid }} .tks-eml__btn:hover{transform:translateY(-1px);opacity:.9;}
  #tks-eml-{{ uid }} .tks-eml__ok{width:100%;margin:0 0 4px;font-size:13px;color:var(--c-head);font-weight:600;}
  #tks-eml-{{ uid }} .tks-eml__visual{position:relative;border-radius:var(--r);min-height:280px;overflow:hidden;background:radial-gradient(120% 100% at 30% 0%,var(--c-panel-a),var(--c-panel-b));border:1px solid rgba(255,255,255,.6);}
  #tks-eml-{{ uid }} .tks-eml__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  #tks-eml-{{ uid }} .tks-eml__rect{position:absolute;border-radius:calc(var(--r)*.7);background:linear-gradient(135deg,rgba(255,255,255,.4),rgba(255,255,255,.08));border:1px solid rgba(255,255,255,.7);}
  #tks-eml-{{ uid }} .tks-eml__rect--a{top:26px;left:12%;width:52%;height:70%;}
  #tks-eml-{{ uid }} .tks-eml__rect--b{top:60px;left:34%;width:52%;height:64%;}
  @media(max-width:900px){#tks-eml-{{ uid }} .tks-eml__inner{grid-template-columns:1fr;}#tks-eml-{{ uid }} .tks-eml__visual{min-height:220px;}}
</style>
{% schema %}
{
  "name":"TKS Email Capture","tag":"section","class":"section-tks-eml",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Email Capture"},
    {"type":"text","id":"heading","label":"Heading","default":"Join the movement"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"times_new_roman_n4"},
    {"type":"textarea","id":"body","label":"Body","default":"Get first access to limited drops, exclusive releases, founder stories, and pieces stitched with purpose."},
    {"type":"text","id":"perks","label":"Perks pill","default":"10% off your first order / Early access to drops"},
    {"type":"text","id":"placeholder","label":"Input placeholder","default":"Enter your email address"},
    {"type":"text","id":"button_label","label":"Button label","default":"Join now"},
    {"type":"text","id":"success_text","label":"Success message","default":"Thanks — you're on the list."},
    {"type":"image_picker","id":"image","label":"Right image (optional)"},
    {"type":"header","content":"Colours"},
    {"type":"color","id":"page_bg","label":"Page background","default":"#efe9e0"},
    {"type":"color","id":"frame_start","label":"Frame gradient top","default":"#faf6ef"},
    {"type":"color","id":"frame_end","label":"Frame gradient bottom","default":"#efe7db"},
    {"type":"color","id":"panel_start","label":"Visual gradient top","default":"#f2ece1"},
    {"type":"color","id":"panel_end","label":"Visual gradient bottom","default":"#e2d7c5"},
    {"type":"color","id":"input_bg","label":"Input pill bg","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#1c1a17"},
    {"type":"color","id":"muted_color","label":"Body","default":"#7d7264"},
    {"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#8a7f70"},
    {"type":"color","id":"button_bg","label":"Button bg","default":"#1c1a17"},
    {"type":"color","id":"button_text","label":"Button text","default":"#ffffff"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":18},
    {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":4,"unit":"px","default":64},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"unit":"px","default":64}
  ],
  "presets":[{"name":"TKS Email Capture"}]
}
{% endschema %}
