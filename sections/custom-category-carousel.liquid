{% comment %}
  Zenn-space "Shop by category" carousel.
  Horizontal, scroll-snapping row of rounded image cards, each linking to a
  collection. Blocks let the merchant add/remove/reorder categories.
  Brand tokens + Fraunces come from snippets/zenn-brand.liquid.
{% endcomment %}

{% render 'zenn-brand' %}
{{ 'custom-category-carousel.css' | asset_url | stylesheet_tag }}

{% liquid
  assign s = section.settings
  assign bg = s.background | default: 'ivory'
%}

<section class="zenn-cats zenn-cats--{{ bg }}" style="--zenn-cats-cols: {{ s.columns | default: 4 }};">
  <div class="zenn-cats__wrap">
    <div class="zenn-cats__head">
      <div class="zenn-cats__head-text">
        {%- if s.eyebrow != blank -%}
          <p class="zenn-cats__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="zenn-cats__title">{{ s.heading | escape }}</h2>
        {%- endif -%}
      </div>

      <div class="zenn-cats__head-actions">
        {%- if s.link_label != blank and s.link_url != blank -%}
          <a class="zenn-cats__viewall" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>
        {%- endif -%}
        <div class="zenn-cats__nav" data-count="{{ section.blocks.size }}">
          <button class="zenn-cats__arrow" type="button" data-dir="prev" aria-label="Scroll to previous categories">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="zenn-cats__arrow" type="button" data-dir="next" aria-label="Scroll to next categories">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
              <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <ul class="zenn-cats__track" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign href = b.link | default: '#'
        -%}
        <li class="zenn-cats__item" {{ block.shopify_attributes }}>
          <a class="zenn-cats__card" href="{{ href }}">
            <div class="zenn-cats__media">
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 450, 600, 900',
                    sizes: '(max-width: 749px) 60vw, 24vw',
                    class: 'zenn-cats__img',
                    loading: 'lazy',
                    alt: b.image.alt | default: b.title
                }}
              {%- else -%}
                <div class="zenn-cats__img zenn-cats__img--placeholder" aria-hidden="true"></div>
              {%- endif -%}
              {%- if b.badge != blank -%}
                <span class="zenn-cats__badge">{{ b.badge | escape }}</span>
              {%- endif -%}
            </div>
            <span class="zenn-cats__label">
              {{ b.title | escape }}
              <svg class="zenn-cats__label-arrow" viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% javascript %}
  (function () {
    function initCats(root) {
      var carousels = (root || document).querySelectorAll('.zenn-cats');
      carousels.forEach(function (el) {
        if (el.dataset.znInit === '1') return;
        el.dataset.znInit = '1';

        var track = el.querySelector('.zenn-cats__track');
        var prev = el.querySelector('[data-dir="prev"]');
        var next = el.querySelector('[data-dir="next"]');
        if (!track || !prev || !next) return;

        function step() {
          var card = track.querySelector('.zenn-cats__item');
          var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0) || 0;
          var w = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
          return Math.max(w, 120);
        }

        function update() {
          var max = track.scrollWidth - track.clientWidth - 2;
          prev.disabled = track.scrollLeft <= 2;
          next.disabled = track.scrollLeft >= max;
          var overflowing = track.scrollWidth > track.clientWidth + 4;
          el.classList.toggle('zenn-cats--static', !overflowing);
        }

        prev.addEventListener('click', function () {
          track.scrollBy({ left: -step() * 2, behavior: 'smooth' });
        });
        next.addEventListener('click', function () {
          track.scrollBy({ left: step() * 2, behavior: 'smooth' });
        });
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      });
    }

    if (document.readyState !== 'loading') {
      initCats();
    } else {
      document.addEventListener('DOMContentLoaded', function () { initCats(); });
    }
    document.addEventListener('shopify:section:load', function (e) { initCats(e.target); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "zenn-cats-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View-all link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "View-all link"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards visible (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "white", "label": "White" }
      ],
      "default": "ivory"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait images work best. A brand placeholder shows if empty."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "info": "e.g. New, Up to 30% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "New Arrivals", "badge": "New" } },
        { "type": "category", "settings": { "title": "Outerwear" } },
        { "type": "category", "settings": { "title": "Knitwear" } },
        { "type": "category", "settings": { "title": "Accessories" } },
        { "type": "category", "settings": { "title": "Footwear" } }
      ]
    }
  ]
}
{% endschema %}
