{%- comment -%}
  shop-by-league — built pixel-accurate from the Figma "section/shop-by-league" (node 1:345).
  Heading + button on the left, a grid of league tiles on the right, on a black band.
  Desktop: text column + 4-up tile grid. Mobile: text stacked above a 2-up tile grid.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id | replace: '_', '' | downcase
  assign bg_alpha = s.text_bg_opacity | divided_by: 100.0
  assign text_bg = s.text_bg_color | color_modify: 'alpha', bg_alpha
-%}

{%- style -%}
  #sbl-{{ uid }} {
    background: {{ s.section_bg_color }};
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
    --sbl-font: 'Trade Gothic LT Std', 'Oswald', 'Arial Narrow', Helvetica, Arial, sans-serif;
  }
  #sbl-{{ uid }} .sbl-wrap {
    max-width: {{ s.content_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 0;
  }
  #sbl-{{ uid }} .sbl-text {
    flex: 0 0 auto;
    width: {{ s.text_max_width }}px;
    max-width: {{ s.text_max_width }}px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    text-align: {{ s.text_align }};
    {%- if s.text_align == 'center' -%}align-items: center;
    {%- elsif s.text_align == 'right' -%}align-items: flex-end;
    {%- else -%}align-items: flex-start;{%- endif -%}
    background: {{ text_bg }};
    padding: {{ s.text_padding }}px;
    border-radius: {{ s.text_border_radius }}px;
  }
  #sbl-{{ uid }} .sbl-heading {
    margin: 0;
    font-family: var(--sbl-font);
    font-size: {{ s.heading_size }}px;
    font-weight: {{ s.font_weight }};
    line-height: {{ s.line_height }};
    letter-spacing: {{ s.letter_spacing }}px;
    color: {{ s.text_color }};
    text-transform: uppercase;
    word-break: break-word;
  }
  #sbl-{{ uid }} .sbl-desc {
    margin: 14px 0 0;
    font-family: var(--sbl-font);
    font-size: {{ s.description_size }}px;
    font-weight: {{ s.font_weight }};
    line-height: {{ s.line_height }};
    letter-spacing: {{ s.letter_spacing }}px;
    color: {{ s.text_color }};
    word-break: break-word;
  }
  #sbl-{{ uid }} .sbl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    padding: 17px 30px 12px;
    background: #ffffff;
    color: #000000;
    border-radius: 100px;
    font-family: var(--sbl-font);
    font-size: {{ s.button_size }}px;
    font-weight: 700;
    line-height: normal;
    letter-spacing: {{ s.letter_spacing }}px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  #sbl-{{ uid }} .sbl-grid {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  #sbl-{{ uid }} .sbl-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #000000;
    border-left: 1px solid rgba(255,255,255,0.1);
    border-right: 1px solid rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  #sbl-{{ uid }} .sbl-tile-logo {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-top: 8%;
  }
  #sbl-{{ uid }} .sbl-tile-logo img {
    max-width: 55%;
    max-height: 100px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  #sbl-{{ uid }} .sbl-tile-label {
    font-family: var(--sbl-font);
    font-size: 16px;
    font-weight: 300;
    color: {{ s.tile_label_color }};
    text-align: center;
    padding-bottom: 28px;
    white-space: nowrap;
  }

  @media (max-width: 989px) {
    #sbl-{{ uid }} .sbl-wrap { flex-direction: column; align-items: stretch; gap: 28px; }
    #sbl-{{ uid }} .sbl-text { width: 100%; max-width: 100%; }
    #sbl-{{ uid }} .sbl-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    #sbl-{{ uid }} .sbl-grid { grid-template-columns: repeat(2, 1fr); }
    #sbl-{{ uid }} .sbl-heading { font-size: {{ s.heading_size | times: 0.62 | round }}px; }
    #sbl-{{ uid }} .sbl-tile-label { padding-bottom: 18px; }
  }
{%- endstyle -%}

<section id="sbl-{{ uid }}" class="sbl-section">
  <div class="sbl-wrap">
    <div class="sbl-text">
      {%- if s.heading != blank -%}
        <h2 class="sbl-heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.description != blank -%}
        <div class="sbl-desc">{{ s.description }}</div>
      {%- endif -%}
      {%- if s.button_text != blank -%}
        <a class="sbl-btn" href="{{ s.button_url | default: '#' }}">{{ s.button_text }}</a>
      {%- endif -%}
    </div>

    <div class="sbl-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign logo = ''
          if block.settings.image != blank
            assign logo = block.settings.image | image_url: width: 300
          elsif block.settings.image_default != blank
            assign logo = block.settings.image_default | asset_url
          endif
        -%}
        <a class="sbl-tile" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="sbl-tile-logo">
            {%- if logo != blank -%}
              <img src="{{ logo }}" alt="{{ block.settings.label | escape }}" width="300" height="300" loading="lazy">
            {%- endif -%}
          </span>
          {%- if block.settings.label != blank -%}
            <span class="sbl-tile-label">{{ block.settings.label }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- schema -%}
{
  "name": "Shop by League",
  "tag": "section",
  "class": "section-shop-by-league",
  "settings": [
    { "type": "header", "content": "Text content" },
    { "type": "text", "id": "heading", "label": "Heading text", "default": "SHOP BY LEAGUE" },
    { "type": "textarea", "id": "description", "label": "Description text" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "SEE ALL LEAGUES" },
    { "type": "url", "id": "button_url", "label": "Button URL" },

    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Heading font size", "min": 16, "max": 96, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "description_size", "label": "Description font size", "min": 10, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_size", "label": "Button font size", "min": 10, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "font_weight", "label": "Font weight", "options": [
      { "value": "300", "label": "Light (300)" }, { "value": "400", "label": "Regular (400)" },
      { "value": "500", "label": "Medium (500)" }, { "value": "600", "label": "Semibold (600)" },
      { "value": "700", "label": "Bold (700)" }
    ], "default": "700" },
    { "type": "range", "id": "line_height", "label": "Line height", "min": 0.8, "max": 2.5, "step": 0.1, "default": 1.0 },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": -2, "max": 10, "step": 0.5, "unit": "px", "default": 0 },

    { "type": "header", "content": "Text colours & box" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_bg_color", "label": "Text background color", "default": "#000000" },
    { "type": "range", "id": "text_bg_opacity", "label": "Text background opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 },
    { "type": "range", "id": "text_padding", "label": "Text padding", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_border_radius", "label": "Text border radius", "min": 0, "max": 80, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_max_width", "label": "Text maximum width", "min": 240, "max": 800, "step": 10, "unit": "px", "default": 410 },

    { "type": "header", "content": "Section" },
    { "type": "color", "id": "section_bg_color", "label": "Section background", "default": "#000000" },
    { "type": "color", "id": "tile_label_color", "label": "Tile label color", "default": "#FFFFFF" },
    { "type": "range", "id": "content_width", "label": "Content max width", "min": 900, "max": 1600, "step": 10, "unit": "px", "default": 1310 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "league",
      "name": "League",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo (overrides default)" },
        { "type": "text", "id": "image_default", "label": "Default logo asset filename", "info": "Theme asset used when no logo is uploaded (e.g. league-mlb.png)" },
        { "type": "text", "id": "label", "label": "Label", "default": "LEAGUE" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Shop by League",
      "blocks": [
        { "type": "league", "settings": { "label": "MLB",  "image_default": "league-mlb.png" } },
        { "type": "league", "settings": { "label": "NFL",  "image_default": "league-nfl.png" } },
        { "type": "league", "settings": { "label": "NBA",  "image_default": "league-nba.png" } },
        { "type": "league", "settings": { "label": "NHL",  "image_default": "league-nhl.png" } },
        { "type": "league", "settings": { "label": "MLS",  "image_default": "league-mls.png" } },
        { "type": "league", "settings": { "label": "MiLB", "image_default": "league-milb.png" } },
        { "type": "league", "settings": { "label": "NCAA", "image_default": "league-ncaa.png" } },
        { "type": "league", "settings": { "label": "WNBA", "image_default": "league-wnba.png" } }
      ]
    }
  ]
}
{%- endschema -%}
