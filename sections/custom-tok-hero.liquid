{% comment %}
  Custom "THREADS OF KAOS" hero / light campaign landing header.
  Self-contained: markup + scoped styles in one file.
  Left = oversized serif brand statement + dual CTA. Right = staggered
  frosted campaign panels with a floating launch badge.
  All colours, radii, copy, panels and buttons are editable.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<section
  class="tok-hero"
  id="tok-hero-{{ uid }}"
  style="
    --tk-page-bg: {{ s.page_bg }};
    --tk-panel-start: {{ s.panel_start }};
    --tk-panel-end: {{ s.panel_end }};
    --tk-card-bg: {{ s.card_bg }};
    --tk-heading: {{ s.heading_color }};
    --tk-muted: {{ s.muted_color }};
    --tk-eyebrow: {{ s.eyebrow_color }};
    --tk-pill-bg: {{ s.pill_bg }};
    --tk-pill-text: {{ s.pill_text }};
    --tk-outline: {{ s.outline_color }};
    --tk-radius: {{ s.corner_radius }}px;
    --tk-pad-y: {{ s.padding_top }}px {{ s.padding_bottom }}px;
  "
>
  <div class="tok-hero__frame">
    <div class="tok-hero__inner">
      {%- comment -%} ---------- LEFT ---------- {%- endcomment -%}
      <div class="tok-hero__left">
        {% if s.eyebrow != blank %}
          <p class="tok-hero__eyebrow"><span class="tok-hero__dash"></span>{{ s.eyebrow }}</p>
        {% endif %}
        {% if s.heading != blank %}
          <h2 class="tok-hero__title">{{ s.heading }}</h2>
        {% endif %}
        {% if s.kicker != blank %}
          <p class="tok-hero__kicker">{{ s.kicker }}</p>
        {% endif %}
        {% if s.heading_2 != blank %}
          <h2 class="tok-hero__title tok-hero__title--2">{{ s.heading_2 }}</h2>
        {% endif %}
        {% if s.body != blank %}
          <div class="tok-hero__body">{{ s.body }}</div>
        {% endif %}

        {% if s.button_1_label != blank or s.button_2_label != blank %}
          <div class="tok-hero__cta">
            {% if s.button_1_label != blank %}
              <a class="tok-hero__pill" {% if s.button_1_link != blank %}href="{{ s.button_1_link }}"{% else %}href="#" role="button"{% endif %}>{{ s.button_1_label }}</a>
            {% endif %}
            {% if s.button_2_label != blank %}
              <a class="tok-hero__pill tok-hero__pill--ghost" {% if s.button_2_link != blank %}href="{{ s.button_2_link }}"{% else %}href="#" role="button"{% endif %}>{{ s.button_2_label }}</a>
            {% endif %}
          </div>
        {% endif %}

        {% if s.footer_text != blank %}
          <p class="tok-hero__footer"><span class="tok-hero__dot"></span>{{ s.footer_text }}</p>
        {% endif %}
      </div>

      {%- comment -%} ---------- RIGHT (staggered panels) ---------- {%- endcomment -%}
      <div class="tok-hero__right">
        {% for block in section.blocks %}
          {%- assign b = block.settings -%}
          <div
            class="tok-hero__panel"
            style="--p-h: {{ b.panel_height }}px; --p-offset: {{ b.offset_top }}px;"
            {{ block.shopify_attributes }}
          >
            {% if b.image != blank %}
              {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'tok-hero__panel-img', widths: '300,600,900', alt: b.title }}
            {% endif %}
            {% if b.eyebrow != blank or b.title != blank or b.text != blank %}
              <div class="tok-hero__panel-card">
                {% if b.eyebrow != blank %}<p class="tok-hero__mini-eyebrow">{{ b.eyebrow }}</p>{% endif %}
                {% if b.title != blank %}<h3 class="tok-hero__panel-title">{{ b.title }}</h3>{% endif %}
                {% if b.text != blank %}<p class="tok-hero__panel-text">{{ b.text }}</p>{% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}

        {% if s.badge_title != blank or s.badge_text != blank %}
          <div class="tok-hero__badge">
            {% if s.badge_mark != blank %}<span class="tok-hero__badge-mark">{{ s.badge_mark }}</span>{% endif %}
            <div class="tok-hero__badge-body">
              {% if s.badge_title != blank %}<p class="tok-hero__mini-eyebrow">{{ s.badge_title }}</p>{% endif %}
              {% if s.badge_text != blank %}<p class="tok-hero__badge-text">{{ s.badge_text }}</p>{% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #tok-hero-{{ uid }}.tok-hero {
    padding: var(--tk-pad-y);
    background: var(--tk-page-bg);
  }
  #tok-hero-{{ uid }} .tok-hero__frame {
    max-width: 1360px;
    margin: 0 auto;
    padding: clamp(32px, 4vw, 64px);
    border-radius: calc(var(--tk-radius) * 1.6);
    background: radial-gradient(120% 120% at 80% 0%, var(--tk-panel-start) 0%, var(--tk-panel-end) 70%);
    box-shadow: 0 40px 90px -50px rgba(60,45,30,0.5);
  }
  #tok-hero-{{ uid }} .tok-hero__inner {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  /* ---- LEFT ---- */
  #tok-hero-{{ uid }} .tok-hero__eyebrow,
  #tok-hero-{{ uid }} .tok-hero__mini-eyebrow {
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--tk-eyebrow); font-weight: 600; margin: 0 0 22px;
    display: flex; align-items: center; gap: 12px;
  }
  #tok-hero-{{ uid }} .tok-hero__dash { width: 26px; height: 1px; background: var(--tk-eyebrow); display: inline-block; }
  #tok-hero-{{ uid }} .tok-hero__title {
    font-family: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    font-weight: {{ s.heading_font.weight }};
    font-size: clamp(46px, 5.6vw, 82px);
    line-height: 0.92; letter-spacing: -0.015em;
    color: var(--tk-heading); margin: 0;
  }
  #tok-hero-{{ uid }} .tok-hero__title--2 { margin-top: 6px; }
  #tok-hero-{{ uid }} .tok-hero__kicker {
    font-size: 13px; letter-spacing: 0.24em; text-transform: uppercase;
    font-weight: 600; color: var(--tk-heading); margin: 18px 0 14px;
  }
  #tok-hero-{{ uid }} .tok-hero__body {
    font-size: 16px; line-height: 1.65; color: var(--tk-muted);
    margin: 28px 0 0; max-width: 34ch;
  }
  #tok-hero-{{ uid }} .tok-hero__body p { margin: 0; }
  #tok-hero-{{ uid }} .tok-hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin: 34px 0 0; }
  #tok-hero-{{ uid }} .tok-hero__pill {
    display: inline-block; background: var(--tk-pill-bg); color: var(--tk-pill-text);
    font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600;
    padding: 16px 32px; border-radius: 999px; text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  #tok-hero-{{ uid }} .tok-hero__pill:hover { transform: translateY(-1px); opacity: 0.9; }
  #tok-hero-{{ uid }} .tok-hero__pill--ghost {
    background: transparent; color: var(--tk-heading);
    border: 1px solid var(--tk-outline);
  }
  #tok-hero-{{ uid }} .tok-hero__footer {
    display: flex; align-items: center; gap: 10px; margin: 40px 0 0;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--tk-eyebrow); font-weight: 600;
  }
  #tok-hero-{{ uid }} .tok-hero__dot { width: 7px; height: 7px; border-radius: 50%; background: {{ s.dot_color }}; display: inline-block; }

  /* ---- RIGHT staggered panels ---- */
  #tok-hero-{{ uid }} .tok-hero__right {
    position: relative;
    display: flex; gap: 20px; align-items: flex-start; justify-content: center;
  }
  #tok-hero-{{ uid }} .tok-hero__panel {
    position: relative;
    flex: 1 1 0; min-width: 0;
    height: var(--p-h, 460px);
    margin-top: var(--p-offset, 0px);
    border-radius: calc(var(--tk-radius) * 1.1);
    background: linear-gradient(180deg, rgba(255,255,255,0.55), rgba(255,255,255,0.12));
    border: 1px solid rgba(255,255,255,0.7);
    box-shadow: 0 26px 50px -30px rgba(60,45,30,0.4);
    overflow: hidden;
    display: flex; align-items: flex-end;
  }
  #tok-hero-{{ uid }} .tok-hero__panel-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #tok-hero-{{ uid }} .tok-hero__panel-card {
    position: relative; z-index: 1;
    margin: 12px; padding: 16px 16px 18px;
    background: var(--tk-card-bg); border-radius: calc(var(--tk-radius) * 0.7);
    box-shadow: 0 14px 30px -16px rgba(60,45,30,0.35);
    width: calc(100% - 24px);
  }
  #tok-hero-{{ uid }} .tok-hero__panel-card .tok-hero__mini-eyebrow { margin-bottom: 10px; font-size: 9px; }
  #tok-hero-{{ uid }} .tok-hero__panel-title {
    font-family: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    font-weight: {{ s.heading_font.weight }};
    font-size: 19px; line-height: 1.12; color: var(--tk-heading); margin: 0 0 8px;
  }
  #tok-hero-{{ uid }} .tok-hero__panel-text { font-size: 12px; line-height: 1.5; color: var(--tk-muted); margin: 0; }

  /* ---- floating badge ---- */
  #tok-hero-{{ uid }} .tok-hero__badge {
    position: absolute; left: 6%; bottom: -14px; z-index: 3;
    display: flex; align-items: center; gap: 14px;
    background: var(--tk-card-bg); border-radius: 16px;
    padding: 14px 20px 14px 14px;
    box-shadow: 0 24px 50px -20px rgba(60,45,30,0.5);
    max-width: 320px;
  }
  #tok-hero-{{ uid }} .tok-hero__badge-mark {
    flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%;
    background: var(--tk-pill-bg); color: var(--tk-pill-text);
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; letter-spacing: 0.12em; font-weight: 700; text-transform: uppercase;
  }
  #tok-hero-{{ uid }} .tok-hero__badge-text { font-size: 12px; line-height: 1.45; color: var(--tk-muted); margin: 0; }

  @media (max-width: 900px) {
    #tok-hero-{{ uid }} .tok-hero__inner { grid-template-columns: 1fr; }
    #tok-hero-{{ uid }} .tok-hero__panel { height: calc(var(--p-h, 460px) * 0.7); margin-top: 0; }
    #tok-hero-{{ uid }} .tok-hero__badge { position: static; margin-top: 20px; max-width: none; }
  }
</style>

{% schema %}
{
  "name": "THREADS OF KAOS Hero",
  "tag": "section",
  "class": "section-tok-hero",
  "settings": [
    { "type": "header", "content": "Headline" },
    { "type": "text", "id": "eyebrow", "label": "Top eyebrow", "default": "Luxury Streetwear / Light Campaign Landing Page" },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Threads of Kaos" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Not clothing." },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "Identity, rebuilt." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Luxury streetwear for the ones who survived chaos and rebuilt themselves. Born from pain. Refined through fire. Worn with purpose.</p>" },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "times_new_roman_n4"
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Primary label", "default": "Shop the drop" },
    { "type": "url", "id": "button_1_link", "label": "Primary link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary label", "default": "Our story" },
    { "type": "url", "id": "button_2_link", "label": "Secondary link" },
    { "type": "text", "id": "footer_text", "label": "Footer tag", "default": "Built From Broken" },
    { "type": "header", "content": "Floating badge" },
    { "type": "text", "id": "badge_mark", "label": "Badge mark", "default": "DROP" },
    { "type": "text", "id": "badge_title", "label": "Badge title", "default": "Premium Launch Aesthetic" },
    { "type": "textarea", "id": "badge_text", "label": "Badge text", "default": "Editorial layout, light luxury palette, conversion-first storytelling." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "page_bg", "label": "Page background", "default": "#efe9e0" },
    { "type": "color", "id": "panel_start", "label": "Frame gradient — top", "default": "#f7f3ec" },
    { "type": "color", "id": "panel_end", "label": "Frame gradient — bottom", "default": "#eae2d5" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading text", "default": "#1c1a17" },
    { "type": "color", "id": "muted_color", "label": "Body text", "default": "#7d7264" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow text", "default": "#8a7f70" },
    { "type": "color", "id": "pill_bg", "label": "Primary button bg", "default": "#1c1a17" },
    { "type": "color", "id": "pill_text", "label": "Primary button text", "default": "#ffffff" },
    { "type": "color", "id": "outline_color", "label": "Outline button border", "default": "#c9bfae" },
    { "type": "color", "id": "dot_color", "label": "Footer dot", "default": "#c9a24b" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Campaign panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Symbol / Crown" },
        { "type": "text", "id": "title", "label": "Title", "default": "Reclaimed Power" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Premium editorial placeholder panel designed to suggest texture, presence, and luxury campaign energy." },
        { "type": "range", "id": "panel_height", "label": "Panel height", "min": 280, "max": 620, "step": 10, "unit": "px", "default": 480 },
        { "type": "range", "id": "offset_top", "label": "Vertical offset", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
      ]
    }
  ],
  "presets": [
    {
      "name": "THREADS OF KAOS Hero",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "eyebrow": "Symbol / Crown",
            "title": "Reclaimed Power",
            "text": "Premium editorial placeholder panel designed to suggest texture, presence, and luxury campaign energy.",
            "panel_height": 500,
            "offset_top": 20
          }
        },
        {
          "type": "panel",
          "settings": {
            "eyebrow": "Monogram / 7K",
            "title": "Identity Rebuilt",
            "text": "Airy collage composition.",
            "panel_height": 560,
            "offset_top": 0
          }
        },
        {
          "type": "panel",
          "settings": {
            "eyebrow": "Statement",
            "title": "Built From Broken",
            "text": "A sculpted block for campaign art, detail photography, or signature drop imagery.",
            "panel_height": 420,
            "offset_top": 60
          }
        }
      ]
    }
  ]
}
{% endschema %}
