{%- comment -%}
  recently-viewed — "Recently Viewed" carousel, pixel-built from the headwear
  Figma Desktop PDP (node 1:1544 heading + 1:1607 carousel) and Mobile PDP
  (node 1:4242 + 1:4283). Client-side history via localStorage: when this section
  renders on a product page it records the current product; it then shows the
  most-recent products (excluding the one being viewed) as the shared Figma card.
  Shared styles/behaviour: assets/product-carousel.css + product-carousel.js.
{%- endcomment -%}

{{ 'product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-carousel.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- liquid
  assign s = section.settings
  assign uid = section.id | replace: '_', '' | downcase
-%}

<span data-pc-money-format="{{ shop.money_format | escape }}" data-pc-cdn="{{ 'product-carousel.css' | asset_url | split: '/t/' | first }}" hidden></span>

{%- if product -%}
  {%- capture cur -%}{"id":{{ product.id }},"handle":{{ product.handle | json }},"url":{{ product.url | json }},"title":{{ product.title | json }},"vendor":{{ product.vendor | json }},"featured_image":{{ product.featured_image | image_url: width: 650 | json }},"price":{{ product.price }},"compare_at_price":{{ product.compare_at_price | default: 0 }}}{%- endcapture -%}
{%- endif -%}

<section
  class="pcarousel"
  id="pc-{{ uid }}"
  style="
    --pc-heading-size: {{ s.heading_size }}px;
    --pc-ink: {{ s.text_color }};
    --pc-section-bg: {{ s.section_bg_color }};
    --pc-max-width: {{ s.content_width }}px;
    --pc-side-pad: {{ s.side_padding }}px;
    --pc-pad-top: {{ s.padding_top }}px;
    --pc-pad-bottom: {{ s.padding_bottom }}px;
  "
  data-pc-recent
  data-pc-limit="{{ s.max_products }}"
  {% if product %}data-pc-exclude-id="{{ product.id }}" data-pc-current="{{ cur | escape }}"{% endif %}
  data-pc-ribbon="{{ s.ribbon_text | escape }}"
  data-pc-empty-text="{{ s.empty_text | escape }}"
  {% if s.hide_when_empty %}data-pc-hide-empty{% endif %}
  {{ section.shopify_attributes }}
>
  <div class="pcarousel__wrap">
    <div class="pcarousel__head">
      {%- if s.heading != blank -%}<h2 class="pcarousel__heading">{{ s.heading }}</h2>{%- endif -%}
      <div class="pcarousel__nav">
        <button type="button" class="pcarousel__arrow pcarousel__arrow--prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="pcarousel__arrow pcarousel__arrow--next" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
    <div class="pcarousel__track" role="list"></div>
    <div class="pcarousel__dots"></div>
  </div>
</section>

{%- schema -%}
{
  "name": "Recently Viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading text", "default": "RECENTLY VIEWED" },
    { "type": "range", "id": "heading_size", "label": "Heading font size", "min": 16, "max": 96, "step": 1, "unit": "px", "default": 40 },

    { "type": "header", "content": "Behaviour" },
    { "type": "range", "id": "max_products", "label": "Max products", "min": 2, "max": 16, "step": 1, "default": 10 },
    { "type": "text", "id": "ribbon_text", "label": "Card ribbon text", "info": "Shown top-left on each card. Leave empty to hide.", "default": "EXCLUSIVE" },
    { "type": "checkbox", "id": "hide_when_empty", "label": "Hide section when nothing viewed yet", "default": true },
    { "type": "text", "id": "empty_text", "label": "Empty message", "info": "Shown only if 'hide when empty' is off.", "default": "No recently viewed products yet." },

    { "type": "header", "content": "Colours & layout" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "section_bg_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "range", "id": "content_width", "label": "Content max width", "min": 900, "max": 1600, "step": 10, "unit": "px", "default": 1440 },
    { "type": "range", "id": "side_padding", "label": "Side padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Recently Viewed" }]
}
{%- endschema -%}
