{%- comment -%}
  hero-banner — homepage hero slideshow, built from the Figma Homepage main-banner
  (desktop 1:218 = 1440x480 full-width; mobile 1:3318 = 375x375 square) with the
  pagination dots (1:222). The Figma banner image is a mockup placeholder, so each
  slide takes an uploaded image (desktop + mobile) plus optional overlay copy and a
  button. Full-bleed, pagination dots, optional autoplay.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id | replace: '_', '' | downcase
-%}

{%- style -%}
  @font-face { font-family:'TradeGothicCond'; src:url({{ 'trade-gothic-bold-cond.woff2' | asset_url }}) format('woff2'); font-weight:700; font-style:normal; font-display:swap; }
  @font-face { font-family:'TradeGothicReg'; src:url({{ 'trade-gothic.woff2' | asset_url }}) format('woff2'); font-weight:300 500; font-style:normal; font-display:swap; }

  #hero-{{ uid }} { --hb-head:'TradeGothicCond','Oswald','Arial Narrow',Helvetica,Arial,sans-serif; --hb-body:'TradeGothicReg','Trade Gothic LT Std',Helvetica,Arial,sans-serif; position:relative; width:100%; background:{{ s.section_bg_color }}; box-sizing:border-box; }
  #hero-{{ uid }} * { box-sizing:border-box; }
  #hero-{{ uid }} .hb-viewport { position:relative; width:100%; overflow:hidden; }
  #hero-{{ uid }} .hb-track { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
  #hero-{{ uid }} .hb-track::-webkit-scrollbar { display:none; }
  #hero-{{ uid }} .hb-slide { position:relative; flex:0 0 100%; scroll-snap-align:start; aspect-ratio:1440 / 480; background:{{ s.slide_fallback_bg }}; display:block; text-decoration:none; overflow:hidden; }
  #hero-{{ uid }} .hb-slide img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  #hero-{{ uid }} .hb-slide .hb-mob { display:none; }
  #hero-{{ uid }} .hb-overlay { position:absolute; inset:0; background:rgba(0,0,0,{{ s.overlay_opacity | divided_by: 100.0 }}); }
  #hero-{{ uid }} .hb-content { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; gap:16px; padding:0 8%; z-index:2; }
  #hero-{{ uid }} .hb-content.pos-left { align-items:flex-start; text-align:left; }
  #hero-{{ uid }} .hb-content.pos-center { align-items:center; text-align:center; }
  #hero-{{ uid }} .hb-content.pos-right { align-items:flex-end; text-align:right; }
  #hero-{{ uid }} .hb-title { margin:0; font-family:var(--hb-head); font-weight:700; font-size:clamp(28px,5vw,64px); line-height:1; letter-spacing:0; color:{{ s.text_color }}; text-transform:uppercase; max-width:14ch; }
  #hero-{{ uid }} .hb-sub { margin:0; font-family:var(--hb-body); font-weight:400; font-size:clamp(14px,1.6vw,20px); line-height:1.3; color:{{ s.text_color }}; opacity:.9; max-width:48ch; text-transform:uppercase; }
  #hero-{{ uid }} .hb-btn { display:inline-block; margin-top:6px; font-family:var(--hb-body); font-weight:700; font-size:14px; letter-spacing:.06em; text-transform:uppercase; text-decoration:none; color:{{ s.btn_text_color }}; background:{{ s.btn_bg_color }}; padding:14px 28px; border-radius:4px; }

  #hero-{{ uid }} .hb-dots { position:absolute; left:0; right:0; bottom:28px; display:flex; align-items:center; justify-content:center; gap:8px; z-index:3; }
  #hero-{{ uid }} .hb-dots button { width:8px; height:8px; border-radius:100px; border:0; padding:0; background:rgba(255,255,255,.5); cursor:pointer; transition:width .2s,background .2s; }
  #hero-{{ uid }} .hb-dots button.is-active { width:20px; background:#fff; }

  @media (max-width:600px){
    #hero-{{ uid }} .hb-slide { aspect-ratio:1 / 1; }
    #hero-{{ uid }} .hb-slide .hb-dsk { display:none; }
    #hero-{{ uid }} .hb-slide .hb-mob { display:block; }
    #hero-{{ uid }} .hb-content { padding:0 24px; gap:12px; }
    #hero-{{ uid }} .hb-dots { bottom:18px; }
  }
{%- endstyle -%}

<section id="hero-{{ uid }}" class="hb-section" {{ section.shopify_attributes }}>
  <div class="hb-viewport">
    <div class="hb-track" data-hb-track role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign dsk = ''
          if block.settings.desktop_image != blank
            assign dsk = block.settings.desktop_image | image_url: width: 2200
          elsif block.settings.desktop_image_url != blank
            assign dsk = block.settings.desktop_image_url
          endif
          assign mob = ''
          if block.settings.mobile_image != blank
            assign mob = block.settings.mobile_image | image_url: width: 900
          elsif block.settings.mobile_image_url != blank
            assign mob = block.settings.mobile_image_url
          else
            assign mob = dsk
          endif
        -%}
        {%- liquid
          assign slide_tag = 'div'
          if block.settings.link != blank
            assign slide_tag = 'a'
          endif
        -%}
        <{{ slide_tag }} {% if block.settings.link != blank %}href="{{ block.settings.link }}" {% endif %}class="hb-slide" {{ block.shopify_attributes }}>
          {%- if dsk != blank -%}<img class="hb-dsk" src="{{ dsk }}" alt="{{ block.settings.heading | escape }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} width="1440" height="480">{%- endif -%}
          {%- if mob != blank -%}<img class="hb-mob" src="{{ mob }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="375" height="375">{%- endif -%}
          {%- if s.overlay_opacity > 0 -%}<div class="hb-overlay"></div>{%- endif -%}
          {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
            <div class="hb-content pos-{{ block.settings.text_align }}">
              {%- if block.settings.heading != blank -%}<h2 class="hb-title">{{ block.settings.heading }}</h2>{%- endif -%}
              {%- if block.settings.subheading != blank -%}<p class="hb-sub">{{ block.settings.subheading }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}<span class="hb-btn">{{ block.settings.button_label }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        </{{ slide_tag }}>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}<div class="hb-dots" data-hb-dots></div>{%- endif -%}
  </div>
</section>

<script>
(function(){
  var root=document.getElementById('hero-{{ uid }}'); if(!root) return;
  var track=root.querySelector('[data-hb-track]'), dotsWrap=root.querySelector('[data-hb-dots]');
  var n=track.children.length, auto={{ s.autoplay | default: false }}, speed={{ s.autoplay_speed | default: 5 }}*1000, timer=null;
  function cur(){return Math.round(track.scrollLeft/track.clientWidth);}
  function go(i){track.scrollTo({left:((i%n)+n)%n*track.clientWidth,behavior:'smooth'});}
  if(dotsWrap){for(var i=0;i<n;i++){(function(idx){var b=document.createElement('button');b.type='button';b.setAttribute('aria-label','Slide '+(idx+1));b.addEventListener('click',function(){go(idx);restart();});dotsWrap.appendChild(b);})(i);}}
  function sync(){if(!dotsWrap)return;var c=cur();Array.prototype.forEach.call(dotsWrap.children,function(d,i){d.classList.toggle('is-active',i===c);});}
  function restart(){if(!auto||n<2)return;clearInterval(timer);timer=setInterval(function(){go(cur()+1);},speed);}
  track.addEventListener('scroll',function(){requestAnimationFrame(sync);},{passive:true});
  sync(); restart();
  root.addEventListener('mouseenter',function(){clearInterval(timer);});
  root.addEventListener('mouseleave',restart);
})();
</script>

{%- schema -%}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    { "type": "header", "content": "Slideshow" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay darkness", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 15 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Overlay text color", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_bg_color", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_text_color", "label": "Button text", "default": "#000000" },
    { "type": "color", "id": "section_bg_color", "label": "Section background", "default": "#000000" },
    { "type": "color", "id": "slide_fallback_bg", "label": "Slide fallback background", "default": "#1A1A1A" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image (1440x480)" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (square 375x375)" },
        { "type": "text", "id": "desktop_image_url", "label": "Default desktop image URL", "info": "Shopify Files CDN URL used when no desktop image is picked." },
        { "type": "text", "id": "mobile_image_url", "label": "Default mobile image URL" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "subheading", "label": "Subheading" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Slide / button link" },
        { "type": "select", "id": "text_align", "label": "Text position", "options": [
          { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
        ], "default": "left" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        { "type": "slide", "settings": { "heading": "NEW ERA 59FIFTY", "subheading": "AUTHENTIC ON-FIELD CAPS. ENGINEERED FOR THE GAME.", "button_label": "SHOP NOW", "text_align": "left" } }
      ]
    }
  ]
}
{%- endschema -%}
