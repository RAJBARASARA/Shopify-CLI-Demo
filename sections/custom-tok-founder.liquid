{% comment %} Threads of Kaos — Founder ("Built Through Fire"). Self-contained. {% endcomment %}
{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}
<section class="tks-fnd" id="tks-fnd-{{ uid }}" style="
  --c-page:{{ s.page_bg }};--c-card:{{ s.card_bg }};--c-panel-a:{{ s.panel_start }};--c-panel-b:{{ s.panel_end }};
  --c-head:{{ s.heading_color }};--c-muted:{{ s.muted_color }};--c-eye:{{ s.eyebrow_color }};--c-quote:{{ s.quote_color }};
  --c-oline:{{ s.outline_color }};--r:{{ s.corner_radius }}px;--pad:{{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="tks-fnd__inner">
    <div class="tks-fnd__visual">
      {% if s.image != blank %}{{ s.image | image_url: width: 1200 | image_tag: loading:'lazy', class:'tks-fnd__img', widths:'400,800,1200', alt: s.heading }}
      {% else %}
        <span class="tks-fnd__rect tks-fnd__rect--a" aria-hidden="true"></span>
        <span class="tks-fnd__rect tks-fnd__rect--b" aria-hidden="true"></span>
      {% endif %}
    </div>
    <div class="tks-fnd__card">
      {% if s.eyebrow != blank %}<p class="tks-fnd__eye">{{ s.eyebrow }}</p>{% endif %}
      {% if s.heading != blank %}<h2 class="tks-fnd__title">{{ s.heading }}</h2>{% endif %}
      <span class="tks-fnd__quote" aria-hidden="true">&ldquo;</span>
      {% if s.body != blank %}<div class="tks-fnd__body">{{ s.body }}</div>{% endif %}
      {% if s.name != blank or s.role != blank %}
        <div class="tks-fnd__sign">
          {% if s.name != blank %}<p class="tks-fnd__name">{{ s.name }}</p>{% endif %}
          {% if s.role != blank %}<p class="tks-fnd__role">{{ s.role }}</p>{% endif %}
        </div>
      {% endif %}
      {% if s.button_label != blank %}<a class="tks-fnd__btn" {% if s.button_link != blank %}href="{{ s.button_link }}"{% else %}href="#" role="button"{% endif %}>{{ s.button_label }}</a>{% endif %}
    </div>
  </div>
</section>
<style>
  #tks-fnd-{{ uid }}.tks-fnd{padding:var(--pad);background:var(--c-page);}
  #tks-fnd-{{ uid }} .tks-fnd__inner{max-width:1240px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:.9fr 1.1fr;gap:24px;align-items:stretch;}
  #tks-fnd-{{ uid }} .tks-fnd__visual{position:relative;border-radius:var(--r);min-height:600px;overflow:hidden;background:radial-gradient(120% 100% at 30% 0%,var(--c-panel-a),var(--c-panel-b));border:1px solid rgba(255,255,255,.6);}
  #tks-fnd-{{ uid }} .tks-fnd__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  #tks-fnd-{{ uid }} .tks-fnd__rect{position:absolute;border-radius:calc(var(--r)*.7);background:linear-gradient(135deg,rgba(255,255,255,.4),rgba(255,255,255,.08));border:1px solid rgba(255,255,255,.7);}
  #tks-fnd-{{ uid }} .tks-fnd__rect--a{top:40px;left:14%;width:56%;height:78%;}
  #tks-fnd-{{ uid }} .tks-fnd__rect--b{top:150px;left:34%;width:52%;height:62%;}
  #tks-fnd-{{ uid }} .tks-fnd__card{background:var(--c-card);border-radius:var(--r);padding:clamp(28px,3vw,48px);box-shadow:0 30px 60px -34px rgba(60,45,30,.4);}
  #tks-fnd-{{ uid }} .tks-fnd__eye{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--c-eye);font-weight:600;margin:0 0 18px;}
  #tks-fnd-{{ uid }} .tks-fnd__title{font-family:{{ s.heading_font.family }},{{ s.heading_font.fallback_families }};font-weight:{{ s.heading_font.weight }};font-size:clamp(34px,3.6vw,52px);line-height:1;letter-spacing:-.01em;color:var(--c-head);margin:0;}
  #tks-fnd-{{ uid }} .tks-fnd__quote{display:block;font-family:{{ s.heading_font.family }},serif;font-size:52px;line-height:.4;color:var(--c-quote);margin:24px 0 10px;}
  #tks-fnd-{{ uid }} .tks-fnd__body{font-size:15px;line-height:1.7;color:var(--c-muted);}
  #tks-fnd-{{ uid }} .tks-fnd__body p{margin:0 0 16px;}
  #tks-fnd-{{ uid }} .tks-fnd__sign{border-top:1px solid rgba(60,45,30,.15);padding-top:16px;margin-top:8px;}
  #tks-fnd-{{ uid }} .tks-fnd__name{font-weight:700;color:var(--c-head);margin:0 0 4px;font-size:14px;}
  #tks-fnd-{{ uid }} .tks-fnd__role{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--c-eye);margin:0;}
  #tks-fnd-{{ uid }} .tks-fnd__btn{display:inline-block;margin-top:22px;border:1px solid var(--c-oline);color:var(--c-head);background:transparent;font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;padding:14px 28px;border-radius:999px;text-decoration:none;transition:transform .15s ease;}
  #tks-fnd-{{ uid }} .tks-fnd__btn:hover{transform:translateY(-1px);}
  @media(max-width:900px){#tks-fnd-{{ uid }} .tks-fnd__inner{grid-template-columns:1fr;}#tks-fnd-{{ uid }} .tks-fnd__visual{min-height:360px;}}
</style>
{% schema %}
{
  "name":"TKS Founder","tag":"section","class":"section-tks-fnd",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Founder Section"},
    {"type":"text","id":"heading","label":"Heading","default":"Built through fire"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"times_new_roman_n4"},
    {"type":"richtext","id":"body","label":"Body","default":"<p>Threads of Kaos wasn't created in comfort. It was created through survival. Through grief. Addiction. Loss. Rebuilding.</p><p>This brand exists because healing deserves representation. Because the people carrying invisible battles deserve something that understands them.</p><p>If someone wears Threads of Kaos and feels understood for even a moment, then this brand is doing exactly what it was created to do.</p>"},
    {"type":"text","id":"name","label":"Signature name","default":"Belinda Slusher"},
    {"type":"text","id":"role","label":"Signature role","default":"Founder"},
    {"type":"text","id":"button_label","label":"Button label","default":"Meet the founder"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"image_picker","id":"image","label":"Left image (optional)"},
    {"type":"header","content":"Colours"},
    {"type":"color","id":"page_bg","label":"Page background","default":"#efe9e0"},
    {"type":"color","id":"card_bg","label":"Card background","default":"#faf8f4"},
    {"type":"color","id":"panel_start","label":"Visual gradient top","default":"#f2ece1"},
    {"type":"color","id":"panel_end","label":"Visual gradient bottom","default":"#e2d7c5"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#1c1a17"},
    {"type":"color","id":"muted_color","label":"Body","default":"#7d7264"},
    {"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#8a7f70"},
    {"type":"color","id":"quote_color","label":"Quote mark","default":"#c9a24b"},
    {"type":"color","id":"outline_color","label":"Button border","default":"#c9bfae"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":22},
    {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":4,"unit":"px","default":72},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"unit":"px","default":72}
  ],
  "presets":[{"name":"TKS Founder"}]
}
{% endschema %}
