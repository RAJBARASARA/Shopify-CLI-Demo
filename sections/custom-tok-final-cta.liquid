{% comment %} Threads of Kaos — Final CTA ("Not saved. Self made."). Self-contained. {% endcomment %}
{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}
<section class="tks-cta" id="tks-cta-{{ uid }}" style="
  --c-page:{{ s.page_bg }};--c-frame-a:{{ s.frame_start }};--c-frame-b:{{ s.frame_end }};
  --c-head:{{ s.heading_color }};--c-muted:{{ s.muted_color }};--c-eye:{{ s.eyebrow_color }};
  --c-btn:{{ s.button_bg }};--c-btntxt:{{ s.button_text }};--r:{{ s.corner_radius }}px;--pad:{{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="tks-cta__frame">
    <div class="tks-cta__left">
      {% if s.eyebrow != blank %}<p class="tks-cta__eye">{{ s.eyebrow }}</p>{% endif %}
      {% if s.heading != blank %}<h2 class="tks-cta__title">{{ s.heading }}</h2>{% endif %}
      {% if s.body != blank %}<p class="tks-cta__body">{{ s.body }}</p>{% endif %}
    </div>
    {% if s.button_label != blank %}
      <div class="tks-cta__right">
        <a class="tks-cta__btn" {% if s.button_link != blank %}href="{{ s.button_link }}"{% else %}href="#" role="button"{% endif %}>{{ s.button_label }}</a>
      </div>
    {% endif %}
  </div>
</section>
<style>
  #tks-cta-{{ uid }}.tks-cta{padding:var(--pad);background:var(--c-page);}
  #tks-cta-{{ uid }} .tks-cta__frame{max-width:1240px;margin:0 auto;padding:clamp(32px,4vw,56px);border-radius:calc(var(--r)*1.3);background:radial-gradient(120% 140% at 85% 20%,var(--c-frame-a),var(--c-frame-b));box-shadow:0 34px 70px -44px rgba(60,45,30,.45);display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;}
  #tks-cta-{{ uid }} .tks-cta__eye{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--c-eye);font-weight:600;margin:0 0 16px;}
  #tks-cta-{{ uid }} .tks-cta__title{font-family:{{ s.heading_font.family }},{{ s.heading_font.fallback_families }};font-weight:{{ s.heading_font.weight }};font-size:clamp(36px,5vw,64px);line-height:.98;letter-spacing:-.01em;color:var(--c-head);margin:0 0 18px;}
  #tks-cta-{{ uid }} .tks-cta__body{font-size:15px;line-height:1.6;color:var(--c-muted);margin:0;}
  #tks-cta-{{ uid }} .tks-cta__btn{display:inline-block;background:var(--c-btn);color:var(--c-btntxt);font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;padding:18px 36px;border-radius:999px;text-decoration:none;white-space:nowrap;transition:transform .15s ease,opacity .15s ease;}
  #tks-cta-{{ uid }} .tks-cta__btn:hover{transform:translateY(-1px);opacity:.9;}
  @media(max-width:760px){#tks-cta-{{ uid }} .tks-cta__frame{grid-template-columns:1fr;}}
</style>
{% schema %}
{
  "name":"TKS Final CTA","tag":"section","class":"section-tks-cta",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Final CTA"},
    {"type":"text","id":"heading","label":"Heading","default":"Not saved. Self made."},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"times_new_roman_n4"},
    {"type":"textarea","id":"body","label":"Body","default":"You survived enough. Now wear the reminder."},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop Threads of Kaos"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"header","content":"Colours"},
    {"type":"color","id":"page_bg","label":"Page background","default":"#efe9e0"},
    {"type":"color","id":"frame_start","label":"Frame gradient top","default":"#faf6ef"},
    {"type":"color","id":"frame_end","label":"Frame gradient bottom","default":"#e7ddcd"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#1c1a17"},
    {"type":"color","id":"muted_color","label":"Body","default":"#7d7264"},
    {"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#8a7f70"},
    {"type":"color","id":"button_bg","label":"Button bg","default":"#1c1a17"},
    {"type":"color","id":"button_text","label":"Button text","default":"#ffffff"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":18},
    {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":4,"unit":"px","default":64},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"unit":"px","default":80}
  ],
  "presets":[{"name":"TKS Final CTA"}]
}
{% endschema %}
