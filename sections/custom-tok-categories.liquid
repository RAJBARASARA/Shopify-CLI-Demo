{% comment %} Threads of Kaos — Built For The Rebels (shop categories). Self-contained. {% endcomment %}
{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}
<section class="tks-cat" id="tks-cat-{{ uid }}" style="
  --c-page:{{ s.page_bg }};--c-tile-a:{{ s.tile_start }};--c-tile-b:{{ s.tile_end }};--c-pill:{{ s.pill_bg }};--c-pilltxt:{{ s.pill_text }};
  --c-head:{{ s.heading_color }};--c-eye:{{ s.eyebrow_color }};--r:{{ s.corner_radius }}px;--pad:{{ s.padding_top }}px {{ s.padding_bottom }}px;">
  <div class="tks-cat__inner">
    {% if s.eyebrow != blank %}<p class="tks-cat__eye">{{ s.eyebrow }}</p>{% endif %}
    {% if s.heading != blank %}<h2 class="tks-cat__title">{{ s.heading }}</h2>{% endif %}
    <div class="tks-cat__grid">
      {% for block in section.blocks %}
        {%- assign b = block.settings -%}
        <a class="tks-cat__card" {% if b.link != blank %}href="{{ b.link }}"{% else %}href="#"{% endif %} {{ block.shopify_attributes }}>
          {% if b.image != blank %}{{ b.image | image_url: width: 600 | image_tag: loading:'lazy', class:'tks-cat__img', widths:'200,400,600', alt: b.label }}{% endif %}
          {% if b.label != blank %}<span class="tks-cat__pill">{{ b.label }}</span>{% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>
<style>
  #tks-cat-{{ uid }}.tks-cat{padding:var(--pad);background:var(--c-page);}
  #tks-cat-{{ uid }} .tks-cat__inner{max-width:1240px;margin:0 auto;padding:0 24px;}
  #tks-cat-{{ uid }} .tks-cat__eye{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--c-eye);font-weight:600;margin:0 0 14px;}
  #tks-cat-{{ uid }} .tks-cat__title{font-family:{{ s.heading_font.family }},{{ s.heading_font.fallback_families }};font-weight:{{ s.heading_font.weight }};font-size:clamp(34px,4.4vw,58px);line-height:1;letter-spacing:-.01em;color:var(--c-head);margin:0 0 36px;}
  #tks-cat-{{ uid }} .tks-cat__grid{display:grid;grid-template-columns:repeat(6,1fr);gap:16px;}
  #tks-cat-{{ uid }} .tks-cat__card{position:relative;display:flex;align-items:flex-end;justify-content:center;height:280px;border-radius:var(--r);overflow:hidden;text-decoration:none;background:linear-gradient(180deg,var(--c-tile-a),var(--c-tile-b));border:1px solid rgba(255,255,255,.5);box-shadow:0 24px 46px -30px rgba(60,45,30,.45);transition:transform .18s ease;}
  #tks-cat-{{ uid }} .tks-cat__card:hover{transform:translateY(-4px);}
  #tks-cat-{{ uid }} .tks-cat__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  #tks-cat-{{ uid }} .tks-cat__pill{position:relative;z-index:1;margin-bottom:18px;background:var(--c-pill);color:var(--c-pilltxt);font-size:10px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;padding:9px 16px;border-radius:999px;text-align:center;line-height:1.3;}
  @media(max-width:1024px){#tks-cat-{{ uid }} .tks-cat__grid{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:600px){#tks-cat-{{ uid }} .tks-cat__grid{grid-template-columns:repeat(2,1fr);}#tks-cat-{{ uid }} .tks-cat__card{height:220px;}}
</style>
{% schema %}
{
  "name":"TKS Categories","tag":"section","class":"section-tks-cat",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop Categories"},
    {"type":"text","id":"heading","label":"Heading","default":"Built for the rebels"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"times_new_roman_n4"},
    {"type":"header","content":"Colours"},
    {"type":"color","id":"page_bg","label":"Page background","default":"#efe9e0"},
    {"type":"color","id":"tile_start","label":"Card gradient top","default":"#efe7d8"},
    {"type":"color","id":"tile_end","label":"Card gradient bottom","default":"#b9ab93"},
    {"type":"color","id":"pill_bg","label":"Pill bg","default":"#f4efe6"},
    {"type":"color","id":"pill_text","label":"Pill text","default":"#2b2620"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#1c1a17"},
    {"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#8a7f70"},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":16},
    {"type":"range","id":"padding_top","label":"Padding top","min":0,"max":160,"step":4,"unit":"px","default":64},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":0,"max":160,"step":4,"unit":"px","default":64}
  ],
  "blocks":[{"type":"category","name":"Category","settings":[
    {"type":"image_picker","id":"image","label":"Image (optional)"},
    {"type":"text","id":"label","label":"Label","default":"Men"},
    {"type":"url","id":"link","label":"Link"}
  ]}],
  "presets":[{"name":"TKS Categories","blocks":[
    {"type":"category","settings":{"label":"Men"}},
    {"type":"category","settings":{"label":"Women"}},
    {"type":"category","settings":{"label":"Hoodies"}},
    {"type":"category","settings":{"label":"Tees"}},
    {"type":"category","settings":{"label":"Headwear"}},
    {"type":"category","settings":{"label":"Signature Pieces"}}
  ]}]
}
{% endschema %}
