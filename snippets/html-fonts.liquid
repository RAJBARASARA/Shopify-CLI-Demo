{%- comment -%}
  Loads the Google Fonts used by the html-landing / html-pdp / html-collection
  sections (Cormorant Garamond display + Inter body). Contains no hex, so it
  passes the hardcoded-color commit hook. Rendered once per section; identical
  hrefs are deduped by the browser if two html-* sections share a page.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
