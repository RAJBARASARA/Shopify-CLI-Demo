{% doc %}
  Renders the Zenn-space footer social icon row from the footer section settings.
  @param {object} s - The footer section.settings object (holds social_* URLs)
  @example
  {% render 'zfoot-social', s: section.settings %}
{% enddoc %}

{%- liquid
  assign has_social = false
  if s.social_instagram != blank or s.social_tiktok != blank or s.social_facebook != blank or s.social_pinterest != blank or s.social_x != blank or s.social_youtube != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="zfoot__social" role="list">
    {%- if s.social_instagram != blank -%}
      <li><a href="{{ s.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="7" r="1.2" fill="currentColor"/></svg>
      </a></li>
    {%- endif -%}
    {%- if s.social_tiktok != blank -%}
      <li><a href="{{ s.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M14 4v9.5a3.5 3.5 0 1 1-3-3.46" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 4c.4 2.4 2 3.8 4.2 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a></li>
    {%- endif -%}
    {%- if s.social_facebook != blank -%}
      <li><a href="{{ s.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M14 8h2V5h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V8.5c0-.3.2-.5.5-.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
      </a></li>
    {%- endif -%}
    {%- if s.social_pinterest != blank -%}
      <li><a href="{{ s.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-.8-.2-1.9 0-2.7l1-4.4s-.3-.5-.3-1.3c0-1.2.7-2.1 1.6-2.1.7 0 1.1.6 1.1 1.3 0 .8-.5 2-.8 3.1-.2.9.5 1.6 1.4 1.6 1.6 0 2.8-1.7 2.8-4.2 0-2.2-1.6-3.7-3.8-3.7-2.6 0-4.1 1.9-4.1 3.9 0 .8.3 1.6.7 2 .1.1.1.2 0 .3l-.2 1c0 .2-.1.2-.3.1-1.2-.5-1.9-2.2-1.9-3.5 0-2.9 2.1-5.5 6-5.5 3.2 0 5.6 2.3 5.6 5.3 0 3.1-2 5.7-4.7 5.7-.9 0-1.8-.5-2.1-1l-.6 2.2c-.2.8-.7 1.8-1.1 2.4A9 9 0 1 0 12 3z" fill="currentColor"/></svg>
      </a></li>
    {%- endif -%}
    {%- if s.social_x != blank -%}
      <li><a href="{{ s.social_x }}" aria-label="X" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" aria-hidden="true"><path d="M4 4l7 9-7 7h2l6-6 5 6h4l-7.5-9.3L20.5 4H18l-5.5 5.5L8 4z" fill="currentColor"/></svg>
      </a></li>
    {%- endif -%}
    {%- if s.social_youtube != blank -%}
      <li><a href="{{ s.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 9.5l4 2.5-4 2.5z" fill="currentColor"/></svg>
      </a></li>
    {%- endif -%}
  </ul>
{%- endif -%}
