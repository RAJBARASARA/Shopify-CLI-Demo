    "tks_story_1": {
      "type": "custom-tok-brand-story",
      "name": "TKS Brand Story",
      "settings": {
        "eyebrow": "Brand Story",
        "heading": "This brand wasn't created. It was survived.",
        "heading_font": "times_new_roman_n4",
        "body": "<p>Threads of Kaos was built for the people who weren't supposed to make it.</p><p>The ones who know what loss feels like. What survival costs. What rebuilding demands.</p><p>This is luxury streetwear rooted in resilience. Every piece represents transformation.</p><p>A reminder that your past didn't destroy you. It shaped you.</p><p>We don't believe broken means finished. We believe chaos creates something stronger.</p>",
        "button_label": "Read our story",
        "button_link": "",
        "monogram": "TK",
        "page_bg": "#efe9e0",
        "card_bg": "#faf8f4",
        "panel_start": "#f2ece1",
        "panel_end": "#e2d7c5",
